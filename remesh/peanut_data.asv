Hz_vs_d(:,1) = Hz_vs_d(:,1)-1; %switch from center-center distance to lubrication distance


fit_range = 3:8; % Data-point indices used for the scaling fits.
scaling_fit = polyfit(log(Hz_vs_d(fit_range, 1)), ...
    log(Hz_vs_d(fit_range, 2)), 1);
alpha = scaling_fit(1);
fprintf('Points %d:%d give Hz ~ d^(%.6g).\n', ...
    fit_range(1), fit_range(end), alpha);

beta = 3; % Theoretical scaling Hz ~ d^(-beta).
theory_prefactor = exp(mean(log(Hz_vs_d(fit_range, 2)) ...
    + beta * log(Hz_vs_d(fit_range, 1)+1)));
Hz_theory = theory_prefactor * (Hz_vs_d(:, 1)+1) .^ (-beta);





loglog(Hz_vs_d(:, 1), Hz_vs_d(:, 2), 'o-')
hold on
loglog(Hz_vs_d(:, 1), Hz_theory, '--', 'LineWidth', 1.5)


b = .1;


Hz_lubrication =

legend('Data', sprintf('Far-field (orbiting rotlets) = C d^{-%g}', beta), 'Location', 'best')




xlabel('$\frac{\delta}{a}$',Interpreter='latex',FontSize=20)
ylabel('\omega_{orb}')